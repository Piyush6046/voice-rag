# Copy this file to backend/.env and fill in your keys.
# You only need ONE of the STT providers and ONE of the LLM providers.

# ---- Speech-to-text: choose "sarvam" or "elevenlabs" ----
STT_PROVIDER=sarvam
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# ---- Answer generation: choose "anthropic" or "gemini" ----
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash

# ---- Embedding model (local, downloaded automatically on first run) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval ----
TOP_K=5

# ---- Guardrails ----
OFF_TOPIC_SIM_THRESHOLD=0.28
GROUNDING_OVERLAP_THRESHOLD=0.15
